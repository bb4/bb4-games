package com.barrybecker4.game.twoplayer.gomoku

import com.barrybecker4.game.twoplayer.common.search.SearchableHelper

/**
 * @author Barry Becker
 */
class GoMokuHelper extends SearchableHelper:

  override def createController(): GoMokuController[GoMokuBoard] =
    new GoMokuController[GoMokuBoard](10, 10)

  override def getTestCaseDir(): String =
    EXTERNAL_TEST_CASE_DIR + "gomoku/cases/searchable/"

  override def getStartGameMoveFileName(player1: Boolean): String =
    if player1 then "x" else "y"

  override def getMiddleGameMoveFileName(player1: Boolean): String =
    if player1 then "x" else "y"

  override def getEndGameMoveFileName(player1: Boolean): String =
    if player1 then "x" else "y"
